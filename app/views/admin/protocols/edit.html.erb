<div class="min-h-screen bg-slate-900 text-white" data-controller="admin-protocols">
  <div class="container mx-auto px-4 py-8 max-w-4xl">

    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold">Edit Protocols</h1>
        <p class="text-slate-400 mt-1 text-sm">Drag sections and protocols to reorder. Changes are committed directly to GitHub.</p>
      </div>
      <a href="<%= protocols_path %>" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg text-sm font-medium transition-colors">
        View Protocols
      </a>
    </div>

    <!-- Flash messages -->
    <% if flash[:notice] %>
      <div class="mb-4 px-4 py-3 bg-emerald-900/50 border border-emerald-600 rounded-lg text-emerald-300 text-sm">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 px-4 py-3 bg-red-900/50 border border-red-600 rounded-lg text-red-300 text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: admin_protocols_path, method: :patch, local: true do |f| %>

      <!-- Save button (top) -->
      <div class="mb-6">
        <%= f.submit "Save & Commit to GitHub",
            class: "px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold rounded-lg transition-colors cursor-pointer" %>
      </div>

      <!-- Sections list -->
      <div data-admin-protocols-target="sectionsList" class="space-y-4">
        <% @sections.each_with_index do |section, si| %>
          <div
            data-section
            data-section-index="<%= si %>"
            class="bg-slate-800 rounded-lg border border-slate-700"
          >
            <!-- Section header row -->
            <div class="flex items-center gap-2 p-3 bg-slate-700/50 rounded-t-lg">
              <!-- Drag handle -->
              <span
                data-drag-handle
                class="cursor-grab text-slate-400 hover:text-slate-200 select-none px-1 text-xl leading-none"
                title="Drag to reorder"
                              >&#9776;</span>

              <!-- Section name -->
              <input
                type="text"
                name="sections[<%= si %>][name]"
                value="<%= section['name'] %>"
                placeholder="Section name"
                class="flex-1 px-3 py-1.5 bg-slate-900/60 border border-slate-600 rounded text-white font-semibold placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
              />

              <!-- Section description -->
              <input
                type="text"
                name="sections[<%= si %>][description]"
                value="<%= section['description'] %>"
                placeholder="Description (optional)"
                class="flex-1 px-3 py-1.5 bg-slate-900/60 border border-slate-600 rounded text-slate-300 placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
              />

              <!-- Collapse toggle -->
              <button
                type="button"
                data-action="click->admin-protocols#toggleSection"
                class="px-2 py-1.5 text-slate-400 hover:text-slate-200 text-sm font-mono transition-colors"
                title="Collapse/expand"
              >&#9660;</button>

              <!-- Delete section -->
              <button
                type="button"
                data-action="click->admin-protocols#removeSection"
                class="px-2 py-1.5 text-red-400 hover:text-red-300 text-sm transition-colors"
                title="Delete section"
              >&#10005;</button>
            </div>

            <!-- Section body (protocols) -->
            <div data-section-body class="p-3">
              <div data-protocols-list class="space-y-2 mb-3">
                <% (section['protocols'] || []).each_with_index do |protocol, pi| %>
                  <div
                    data-protocol
                    class="flex items-center gap-2 bg-slate-900/50 border border-slate-700 rounded-lg p-2"
                  >
                    <!-- Protocol drag handle -->
                    <span
                      data-drag-handle
                      class="cursor-grab text-slate-500 hover:text-slate-300 select-none px-1 text-sm leading-none flex-shrink-0"
                      title="Drag to reorder"
                                          >&#9776;</span>

                    <!-- Protocol name -->
                    <input
                      type="text"
                      name="sections[<%= si %>][protocols][<%= pi %>][name]"
                      value="<%= protocol['name'] %>"
                      placeholder="Protocol name"
                      class="w-40 px-2 py-1 bg-slate-800 border border-slate-600 rounded text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
                    />

                    <!-- Protocol code -->
                    <input
                      type="text"
                      name="sections[<%= si %>][protocols][<%= pi %>][code]"
                      value="<%= protocol['code'] %>"
                      placeholder="code e.g. 8(20w10r)"
                      class="w-52 px-2 py-1 bg-slate-800 border border-slate-600 rounded text-amber-300 font-mono placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
                    />

                    <!-- Protocol description -->
                    <input
                      type="text"
                      name="sections[<%= si %>][protocols][<%= pi %>][description]"
                      value="<%= protocol['description'] %>"
                      placeholder="Description"
                      class="flex-1 px-2 py-1 bg-slate-800 border border-slate-600 rounded text-slate-300 placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
                    />

                    <!-- Delete protocol -->
                    <button
                      type="button"
                      data-action="click->admin-protocols#removeProtocol"
                      class="flex-shrink-0 px-2 py-1 text-red-400 hover:text-red-300 text-sm transition-colors"
                      title="Delete protocol"
                    >&#10005;</button>
                  </div>
                <% end %>
              </div>

              <!-- Add protocol button -->
              <button
                type="button"
                data-action="click->admin-protocols#addProtocol"
                data-admin-protocols-section-param="<%= si %>"
                class="w-full px-3 py-1.5 bg-slate-700/50 hover:bg-slate-700 border border-dashed border-slate-600 rounded text-slate-400 hover:text-slate-200 text-sm transition-colors"
              >
                + Add protocol
              </button>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Add section button -->
      <div class="mt-4">
        <button
          type="button"
          data-action="click->admin-protocols#addSection"
          class="w-full px-4 py-3 bg-slate-800 hover:bg-slate-700 border border-dashed border-slate-600 rounded-lg text-slate-400 hover:text-slate-200 font-medium transition-colors"
        >
          + Add section
        </button>
      </div>

      <!-- Save button (bottom) -->
      <div class="mt-6">
        <%= f.submit "Save & Commit to GitHub",
            class: "px-6 py-3 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold rounded-lg transition-colors cursor-pointer" %>
      </div>

    <% end %>
  </div>

  <!-- Hidden templates for cloning -->

  <template id="section-template">
    <div
      data-section
      data-section-index="__SI__"
      class="bg-slate-800 rounded-lg border border-slate-700"
    >
      <div class="flex items-center gap-2 p-3 bg-slate-700/50 rounded-t-lg">
        <span
          data-drag-handle
          class="cursor-grab text-slate-400 hover:text-slate-200 select-none px-1 text-xl leading-none"
          title="Drag to reorder"
                  >&#9776;</span>

        <input
          type="text"
          name="sections[__SI__][name]"
          value=""
          placeholder="Section name"
          class="flex-1 px-3 py-1.5 bg-slate-900/60 border border-slate-600 rounded text-white font-semibold placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
        />

        <input
          type="text"
          name="sections[__SI__][description]"
          value=""
          placeholder="Description (optional)"
          class="flex-1 px-3 py-1.5 bg-slate-900/60 border border-slate-600 rounded text-slate-300 placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
        />

        <button
          type="button"
          data-action="click->admin-protocols#toggleSection"
          class="px-2 py-1.5 text-slate-400 hover:text-slate-200 text-sm font-mono transition-colors"
          title="Collapse/expand"
        >&#9660;</button>

        <button
          type="button"
          data-action="click->admin-protocols#removeSection"
          class="px-2 py-1.5 text-red-400 hover:text-red-300 text-sm transition-colors"
          title="Delete section"
        >&#10005;</button>
      </div>

      <div data-section-body class="p-3">
        <div data-protocols-list class="space-y-2 mb-3"></div>

        <button
          type="button"
          data-action="click->admin-protocols#addProtocol"
          data-admin-protocols-section-param="__SI__"
          class="w-full px-3 py-1.5 bg-slate-700/50 hover:bg-slate-700 border border-dashed border-slate-600 rounded text-slate-400 hover:text-slate-200 text-sm transition-colors"
        >
          + Add protocol
        </button>
      </div>
    </div>
  </template>

  <template id="protocol-template">
    <div
      data-protocol
      class="flex items-center gap-2 bg-slate-900/50 border border-slate-700 rounded-lg p-2"
    >
      <span
        data-drag-handle
        class="cursor-grab text-slate-500 hover:text-slate-300 select-none px-1 text-sm leading-none flex-shrink-0"
        title="Drag to reorder"
              >&#9776;</span>

      <input
        type="text"
        name="sections[__SI__][protocols][__PI__][name]"
        value=""
        placeholder="Protocol name"
        class="w-40 px-2 py-1 bg-slate-800 border border-slate-600 rounded text-white placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
      />

      <input
        type="text"
        name="sections[__SI__][protocols][__PI__][code]"
        value=""
        placeholder="code e.g. 8(20w10r)"
        class="w-52 px-2 py-1 bg-slate-800 border border-slate-600 rounded text-amber-300 font-mono placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
      />

      <input
        type="text"
        name="sections[__SI__][protocols][__PI__][description]"
        value=""
        placeholder="Description"
        class="flex-1 px-2 py-1 bg-slate-800 border border-slate-600 rounded text-slate-300 placeholder-slate-500 focus:border-amber-500 focus:outline-none text-sm"
      />

      <button
        type="button"
        data-action="click->admin-protocols#removeProtocol"
        class="flex-shrink-0 px-2 py-1 text-red-400 hover:text-red-300 text-sm transition-colors"
        title="Delete protocol"
      >&#10005;</button>
    </div>
  </template>

</div>
