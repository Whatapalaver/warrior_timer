# Copy this file to .env and fill in values for local development.
# .env is gitignored and never committed.

# Password for the admin protocols editor at /admin/protocols/edit
ADMIN_PASSWORD=

# GitHub Personal Access Token for committing protocol changes back to the repo.
# Needs Contents: Read & Write on the warrior_timer repo.
# Generate at: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
GITHUB_TOKEN=
